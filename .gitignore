# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# dev/QA artifacts (no forman parte del sitio)
/.playwright-mcp/
/qa-screenshots/

# documentos comerciales para la doctora (precios, propuestas, respuestas del
# cuestionario). No forman parte del sitio y no deben salir del equipo.
/docs-doctora/
/Ortoptika-Preguntas-Doctora.*

# fotos originales del consultorio (full-res, sin recortar). El repo es
# PÚBLICO y varias muestran menores y pacientes identificables: sólo se
# publican los derivados de public/images/fotos/ que tengan autorización.
/assets/fotos-originales/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
